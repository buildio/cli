long_description    Heroku-compatible command-line client for Build.io.
homepage            https://app.build.io

master_sites        https://github.com/buildio/cli/releases/download/v${version}/

if {${build_arch} eq "arm64"} {
    distname        bld-darwin-arm64
    checksums       rmd160  fa7a67082b54f24d23fcf4023da0769b8d6aed68 \
                    sha256  508bff51ba69b192d7b6349f41dc18f492f03510c42b691424fef3792035fc10 \
                    size    1389594
} elseif {${build_arch} eq "x86_64"} {
    distname        bld-darwin-amd64
    checksums       rmd160  3113df52b49c3d644c94c1e9f84ecb927d887a8d \
                    sha256  3939e7c98a3bfc85b216d99f63dc1b213902f712345f4d31cd4674b87dd69f43 \
                    size    1393285
} else {
    known_fail      yes
    pre-fetch {
        return -code error "bld provides prebuilt MacPorts binaries for x86_64 and arm64 only"
    }
}

